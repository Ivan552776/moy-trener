{"v": 1, "segs": [[7.72, 9.64, "Взятие на грудь с плинтов."], [9.64, 11.68, "Старт — с середины бедра."], [11.68, 13.04, "Так исключается любая инерция."], [13.04, 14.72, "Это хорошее положение."], [14.72, 17.12, "Руки расслаблены и свободно висят от плеч."], [17.12, 19.6, "Так ноги работают эффективно."], [19.6, 21.52, "Быстрый толчок ногами и приём штанги."], [21.52, 23.08, "Посмотрим в замедленной съёмке."], [24.44, 26.64, "Смотрите в правый верхний угол экрана."], [30.28, 31.72, "Руки вытянуты."], [32.88, 34.04, "Мощный толчок ногами."], [34.04, 35.2, "Полное выпрямление."], [35.2, 36.76, "Теперь начинаю уходить вниз."], [36.76, 38.72, "Гриф продолжает лететь вверх."], [38.72, 41.22, "Теперь он опускается, но я уже под ним."], [51.04, 53.8, "Частые ошибки в этом упражнении."], [53.8, 55.48, "Атлет тянет руками,"], [55.48, 57.12, "поднимает гриф слишком высоко,"], [57.12, 60.04, "и движение становится медленным: он «доезжает» под гриф."], [60.04, 62.76, "Посмотрим ещё раз в замедлении и сравним."], [63.8, 64.88, "Выпрямляюсь вверх."], [64.88, 66.56, "Выпрямление есть, но я задерживаюсь."], [66.56, 67.76, "Всё ещё тяну, тяну."], [67.76, 69.28, "Только теперь начинаю уходить вниз."], [69.28, 71.08, "Гриф тоже начинает падать."], [72.24, 73.8, "Очень-очень медленно."], [73.8, 75.12, "Совсем не так взрывно."]]}